# ==============================================================================
# CONFIGURACIÓN DE LA APP MÓVIL (FLUTTER)
# ==============================================================================
# SEGURIDAD CRÍTICA:
# Las llamadas a Gemini Vision y MongoDB Atlas se procesan en el backend.
# NUNCA coloques credenciales de MongoDB ni de producción aquí.

# --- Backend API -------------------------------------------------------------
# Dirección del backend Express desplegado o en local.
# Si está vacío, por defecto usará http://10.0.2.2:3000 (emulador Android).
# En la app puedes cambiarla en cualquier momento desde "Configuración del Servidor".
API_BASE_URL=

# Clave de autenticación API / Bearer token (Punto 10).
# Opcional en desarrollo local; obligatoria en producción.
# También se puede ingresar directamente en la app desde "Configuración del Servidor".
API_KEY=

# --- Desarrollo local opcional (Fallback directo a Gemini) ---------------------
# Solo si deseas probar transcripción directa sin backend durante desarrollo.
# En la versión distribuida (APK Release) este campo debe permanecer vacío
# para evitar que la clave sea extraída de los assets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
